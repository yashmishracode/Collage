/* ============================================================
   1. Write a C program to read n elements into an array and
      calculate and display the sum of all array elements.
   ============================================================ */
void question1()
{
    int a[MAX], n, i, sum = 0;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter array elements:\n");
    for (i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
        sum += a[i];
    }

    printf("Sum = %d\n", sum);
}


/* ============================================================
   2. Write a C program to insert an element at any specified
      position in an array. Display the array before and after
      insertion.
   ============================================================ */
void question2()
{
    int a[MAX], n, i, pos, value;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter array elements:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter position and element to insert: ");
    scanf("%d %d", &pos, &value);

    printf("Array before insertion: ");
    for (i = 0; i < n; i++)
        printf("%d ", a[i]);

    for (i = n; i >= pos; i--)
        a[i] = a[i - 1];

    a[pos - 1] = value;
    n++;

    printf("\nArray after insertion: ");
    for (i = 0; i < n; i++)
        printf("%d ", a[i]);

    printf("\n");
}


/* ============================================================
   3. Write a C program to delete an element from any specified
      position in an array. Display the array before and after
      deletion.
   ============================================================ */
void question3()
{
    int a[MAX], n, i, pos;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter array elements:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter position to delete: ");
    scanf("%d", &pos);

    printf("Array before deletion: ");
    for (i = 0; i < n; i++)
        printf("%d ", a[i]);

    for (i = pos - 1; i < n - 1; i++)
        a[i] = a[i + 1];

    n--;

    printf("\nArray after deletion: ");
    for (i = 0; i < n; i++)
        printf("%d ", a[i]);

    printf("\n");
}


/* ============================================================
   4. Write a C program to search for a given element in an
      array using linear search. Display the position if the
      element is found; otherwise, display an appropriate
      message.
   ============================================================ */
void question4()
{
    int a[MAX], n, i, key, position = -1;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter array elements:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter element to search: ");
    scanf("%d", &key);

    for (i = 0; i < n; i++)
    {
        if (a[i] == key)
        {
            position = i + 1;
            break;
        }
    }

    if (position != -1)
        printf("Element found at position %d\n", position);
    else
        printf("Element not found\n");
}


/* ============================================================
   5. Write a C program to sort the elements of an array in
      ascending order. Display the array before and after
      sorting.
   ============================================================ */
void question5()
{
    int a[MAX], n, i, j, temp;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter array elements:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Array before sorting: ");
    for (i = 0; i < n; i++)
        printf("%d ", a[i]);

    for (i = 0; i < n - 1; i++)
    {
        for (j = i + 1; j < n; j++)
        {
            if (a[i] > a[j])
            {
                temp = a[i];
                a[i] = a[j];
                a[j] = temp;
            }
        }
    }

    printf("\nArray after sorting: ");
    for (i = 0; i < n; i++)
        printf("%d ", a[i]);

    printf("\n");
}


/* ============================================================
   6. Write a C program to read two matrices and calculate
      their element-wise sum and difference. Display both
      resulting matrices.
   ============================================================ */
void question6()
{
    int a[10][10], b[10][10];
    int r, c, i, j;

    printf("Enter rows and columns: ");
    scanf("%d %d", &r, &c);

    printf("Enter first matrix:\n");
    for (i = 0; i < r; i++)
        for (j = 0; j < c; j++)
            scanf("%d", &a[i][j]);

    printf("Enter second matrix:\n");
    for (i = 0; i < r; i++)
        for (j = 0; j < c; j++)
            scanf("%d", &b[i][j]);

    printf("\nSum of matrices:\n");
    for (i = 0; i < r; i++)
    {
        for (j = 0; j < c; j++)
            printf("%d\t", a[i][j] + b[i][j]);
        printf("\n");
    }

    printf("\nDifference of matrices (A - B):\n");
    for (i = 0; i < r; i++)
    {
        for (j = 0; j < c; j++)
            printf("%d\t", a[i][j] - b[i][j]);
        printf("\n");
    }
}


/* ============================================================
   7. Write a C program to multiply two matrices. Read the
      dimensions and elements of both matrices, check whether
      multiplication is possible, and display the resulting
      matrix.
   ============================================================ */
void question7()
{
    int a[10][10], b[10][10], c[10][10];
    int r1, c1, r2, c2;
    int i, j, k;

    printf("Enter rows and columns of first matrix: ");
    scanf("%d %d", &r1, &c1);

    printf("Enter rows and columns of second matrix: ");
    scanf("%d %d", &r2, &c2);

    if (c1 != r2)
    {
        printf("Matrix multiplication is not possible.\n");
        return;
    }

    printf("Enter first matrix:\n");
    for (i = 0; i < r1; i++)
        for (j = 0; j < c1; j++)
            scanf("%d", &a[i][j]);

    printf("Enter second matrix:\n");
    for (i = 0; i < r2; i++)
        for (j = 0; j < c2; j++)
            scanf("%d", &b[i][j]);

    for (i = 0; i < r1; i++)
    {
        for (j = 0; j < c2; j++)
        {
            c[i][j] = 0;

            for (k = 0; k < c1; k++)
                c[i][j] += a[i][k] * b[k][j];
        }
    }

    printf("Resultant matrix:\n");

    for (i = 0; i < r1; i++)
    {
        for (j = 0; j < c2; j++)
            printf("%d\t", c[i][j]);

        printf("\n");
    }
}


/* ============================================================
   8. Write a C program to demonstrate the concept of pointers
      using an array. Read array elements and use a pointer to
      access and display the elements and their addresses.
   ============================================================ */
void question8()
{
    int a[MAX], n, i;
    int *p;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter array elements:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    p = a;

    printf("\nElement\tAddress\n");

    for (i = 0; i < n; i++)
        printf("%d\t%p\n", *(p + i), (void *)(p + i));
}


