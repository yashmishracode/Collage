/* ============================================================
   10. Write a C program to implement a stack using an array
       and perform the following operations: PUSH, POP, PEEK,
       and DISPLAY. Also handle stack overflow and underflow
       conditions.
   ============================================================ */
void question10()
{
    int stack[MAX], top = -1;
    int choice, value, i;

    while (1)
    {
        printf("\n--- STACK ---\n");
        printf("1. PUSH\n");
        printf("2. POP\n");
        printf("3. PEEK\n");
        printf("4. DISPLAY\n");
        printf("5. EXIT\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                if (top == MAX - 1)
                    printf("Stack Overflow\n");
                else
                {
                    printf("Enter element: ");
                    scanf("%d", &value);
                    stack[++top] = value;
                }
                break;

            case 2:
                if (top == -1)
                    printf("Stack Underflow\n");
                else
                    printf("Deleted element: %d\n", stack[top--]);
                break;

            case 3:
                if (top == -1)
                    printf("Stack is empty\n");
                else
                    printf("Top element: %d\n", stack[top]);
                break;

            case 4:
                if (top == -1)
                    printf("Stack is empty\n");
                else
                {
                    printf("Stack: ");
                    for (i = top; i >= 0; i--)
                        printf("%d ", stack[i]);
                    printf("\n");
                }
                break;

            case 5:
                return;

            default:
                printf("Invalid choice\n");
        }
    }
}


/* ============================================================
   11. Write a C program to implement a queue using an array
       and perform the following operations: ENQUEUE, DEQUEUE,
       PEEK, and DISPLAY. Also handle queue overflow and
       underflow conditions.
   ============================================================ */
void question11()
{
    int queue[MAX];
    int front = -1, rear = -1;
    int choice, value, i;

    while (1)
    {
        printf("\n--- QUEUE ---\n");
        printf("1. ENQUEUE\n");
        printf("2. DEQUEUE\n");
        printf("3. PEEK\n");
        printf("4. DISPLAY\n");
        printf("5. EXIT\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                if (rear == MAX - 1)
                    printf("Queue Overflow\n");
                else
                {
                    printf("Enter element: ");
                    scanf("%d", &value);

                    if (front == -1)
                        front = 0;

                    queue[++rear] = value;
                }
                break;

            case 2:
                if (front == -1 || front > rear)
                    printf("Queue Underflow\n");
                else
                {
                    printf("Deleted element: %d\n", queue[front++]);

                    if (front > rear)
                        front = rear = -1;
                }
                break;

            case 3:
                if (front == -1)
                    printf("Queue is empty\n");
                else
                    printf("Front element: %d\n", queue[front]);
                break;

            case 4:
                if (front == -1)
                    printf("Queue is empty\n");
                else
                {
                    printf("Queue: ");
                    for (i = front; i <= rear; i++)
                        printf("%d ", queue[i]);
                    printf("\n");
                }
                break;

            case 5:
                return;

            default:
                printf("Invalid choice\n");
        }
    }
}


/* ============================================================
   12. Write a C program to convert an infix expression into
       a postfix expression using a stack. The program should
       consider operator precedence and parentheses.
   ============================================================ */

int precedence(char op)
{
    if (op == '^')
        return 3;

    if (op == '*' || op == '/')
        return 2;

    if (op == '+' || op == '-')
        return 1;

    return 0;
}

void question12()
{
    char infix[MAX], stack[MAX], postfix[MAX];
    int top = -1, i, j = 0;
    char ch;

    printf("Enter infix expression: ");
    scanf("%s", infix);

    for (i = 0; infix[i] != '\0'; i++)
    {
        ch = infix[i];

        /* Operand */
        if (isalnum(ch))
        {
            postfix[j++] = ch;
        }

        /* Opening parenthesis */
        else if (ch == '(')
        {
            stack[++top] = ch;
        }

        /* Closing parenthesis */
        else if (ch == ')')
        {
            while (top != -1 && stack[top] != '(')
                postfix[j++] = stack[top--];

            if (top != -1)
                top--;
        }

        /* Operator */
        else
        {
            while (top != -1 &&
                   stack[top] != '(' &&
                   precedence(stack[top]) >= precedence(ch))
            {
                postfix[j++] = stack[top--];
            }

            stack[++top] = ch;
        }
    }

    while (top != -1)
        postfix[j++] = stack[top--];

    postfix[j] = '\0';

    printf("Postfix expression: %s\n", postfix);
}


